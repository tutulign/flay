    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@stripe/crypto": "^1.1.3",
    "@x402/core": "2.28.0",
    "@x402/svm": "2.28.0",
    "bigint-buffer": "file:./vendor/bigint-buffer",
    "bn.js": "^5.2.2",
    "bs58": "^6.0.0",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "ipaddr.js": "2.5.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.13",
    "tweetnacl": "1.0.3",
    "zod": "^4.6.5"
