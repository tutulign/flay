    "@fontsource-variable/sora": "^5.2.8",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.17.2",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@orca-so/common-sdk": "^0.7.1",
    "@orca-so/whirlpools-sdk": "^0.22.0",
    "@privy-io/node": "^0.34.0",
    "@privy-io/react-auth": "3.42.0",
    "@solana-program/memo": "^0.10.0",
    "@solana-program/system": "^0.10.0",
    "@solana-program/token": "^0.9.0",
