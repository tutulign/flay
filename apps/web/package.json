{
  "name": "flay-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:supervised": "sh scripts/dev-supervisor.sh",
    "build": "tsc --noEmit && NODE_OPTIONS=--max-old-space-size=2048 vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm run test",
    "release:audit": "node scripts/release-audit.mjs",
    "browser:audit": "node scripts/browser-audit.mjs",
    "browser:audit:onramp": "node scripts/onramp-browser-audit.mjs"
  },
