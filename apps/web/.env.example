# Required to enable login, signing, wallet export, and authenticated wallet APIs.
# The browser app ID is public. The verification key must stay server-side.
VITE_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
# Required only for Automatic within guardrails. Keep both values server-side.
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_PRIVATE_KEY=
PRIVY_AGENT_TIMEOUT_MS=15000

# Privy Card Onramps. Sandbox is the safe default; production must be an
# explicit public build setting after dashboard activation and live review.
VITE_PRIVY_ONRAMP_ENV=sandbox

# Optional. Jupiter Swap/Trigger endpoints currently allow keyless requests,
# with lower capacity. Put an API key here for hackathon traffic.
JUPITER_API_KEY=

# xStocks uses its public API and needs no private credential. These optional
# server values tune the fixed official endpoint and bounded caches.
XSTOCKS_BASE_URL=https://api.xstocks.fi/api/v2
XSTOCKS_TIMEOUT_MS=10000
XSTOCKS_DETAIL_TIMEOUT_MS=6000
XSTOCKS_REFERENCE_TIMEOUT_MS=3500
XSTOCKS_ONCHAIN_TIMEOUT_MS=3500
XSTOCKS_CATALOG_TIMEOUT_MS=45000
XSTOCKS_CATALOG_CACHE_MS=600000
XSTOCKS_DETAIL_CACHE_MS=30000

# Use a mainnet Solana RPC with getParsedTokenAccountsByOwner, simulation,
# address lookup tables, and transaction history enabled.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_FALLBACK_RPC_URL=
# Shared server-side HTTP budget. The defaults stay below QuickNode's 15/s
# starter limit and leave headroom for the GMTrade sidecar.
SOLANA_RPC_MAX_RPS=8
SOLANA_RPC_MAX_CONCURRENCY=4
SOLANA_RPC_QUEUE_TIMEOUT_MS=10000

# MagicBlock Ephemeral SPL Token API. The default needs no API key.
MAGICBLOCK_BASE_URL=https://payments.magicblock.app
# Attested mainnet TEE used for real wallet authorization. The default needs no API key.
MAGICBLOCK_TEE_BASE_URL=https://mainnet-tee.magicblock.app
MAGICBLOCK_TIMEOUT_MS=10000

# Futures. The default binary path resolves to the locked local release build.
GMTRADE_ADAPTER_BIN=
GMTRADE_ADAPTER_TIMEOUT_MS=15000

# Paused Alchemy Pay fallback. These server-only values are not used by the
# active Privy Funds UI. Preserve them only for the saved fallback checkpoint.
ALCHEMY_PAY_ENV=test
ALCHEMY_PAY_APP_ID=
ALCHEMY_PAY_APP_SECRET=
ALCHEMY_PAY_PUBLIC_URL=http://localhost:5173
ALCHEMY_PAY_ORDER_STORE_PATH=.flay-data/alchemy-pay-orders.json
ALCHEMY_PAY_ALLOWED_FIAT=USD,EUR,GBP
ALCHEMY_PAY_MIN_FIAT_AMOUNT=15
ALCHEMY_PAY_MAX_FIAT_AMOUNT=1000

# Optional server tuning.
PORT=5173
HOST=0.0.0.0
PROVIDER_TIMEOUT_MS=4500
QUOTE_CACHE_MS=5000
